rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.amount is number && data.amount > 0
        && (data.type == 'income' || data.type == 'expense')
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.paymentMethod == 'card' || data.paymentMethod == 'cash' || data.paymentMethod == 'bank' || data.paymentMethod == 'wallet')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);
    }

    // User transactions subcollection
    match /users/{userId}/transactions/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidTransaction(incoming(), userId)
        && incoming().keys().hasAll(['userId', 'title', 'amount', 'type', 'category', 'date', 'paymentMethod'])
        && incoming().keys().hasOnly(['id', 'userId', 'title', 'amount', 'type', 'category', 'date', 'paymentMethod', 'notes', 'createdAt']);
      allow update: if isOwner(userId)
        && isValidTransaction(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'date', 'paymentMethod', 'notes']);
      allow delete: if isOwner(userId);
    }
  }
}
