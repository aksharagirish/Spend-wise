{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record belonging to a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Transaction title or description"
        },
        "amount": {
          "type": "number",
          "description": "Numeric monetary amount"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Type of transaction"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category name"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Transaction date in YYYY-MM-DD format"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["card", "cash", "bank", "wallet"],
          "description": "Payment instrument used"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional memo or notes"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        }
      },
      "required": ["userId", "title", "amount", "type", "category", "date", "paymentMethod"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User specific transactions subcollection"
    }
  }
}
